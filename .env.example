# PostgreSQL Connection String
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[REF].supabase.co:5432/postgres
# For Vercel Postgres: Use the POSTGRES_URL provided in your Storage tab
DATABASE_URL=your_postgres_url_here

# Optional: Port for local express server
PORT=5000

# Optional: Admin control (overrides default in index.js if implemented)
ADMIN_PASSWORD=admin123
